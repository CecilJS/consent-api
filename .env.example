# --- Local infrastructure: read by docker compose AND the app ---
POSTGRES_USER=consent
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=consent
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=__MONGO_ROOT_PASSWORD__
MONGO_APP_USER=consent_app
MONGO_APP_PASSWORD=__MONGO_APP_PASSWORD__
MONGO_DB=consent_audit

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://consent:__POSTGRES_PASSWORD__@localhost:5432/consent
MONGO_URL=mongodb://consent_app:__MONGO_APP_PASSWORD__@localhost:27017/consent_audit?authSource=consent_audit
MONGO_ADMIN_URL=mongodb://root:__MONGO_ROOT_PASSWORD__@localhost:27017/?authSource=admin

JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_ISSUER=consent-api
JWT_AUDIENCE=consent-api-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

CORS_ORIGINS=http://localhost:5173